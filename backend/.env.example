# Скопируйте этот файл в .env и заполните значения.
# Файл .env НИКОГДА не коммитим в git (он в .gitignore).

# Ключ OpenAI — нужен для Whisper (транскрипция, если у видео нет субтитров)
OPENAI_API_KEY=

# Ключ Anthropic — нужен для генерации твитов через Claude
ANTHROPIC_API_KEY=

# Supabase: Project Settings → API.
# SERVICE KEY (service_role) — полный доступ к базе, только для бэкенда!
# Никогда не отдавать во фронтенд и не коммитить.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Публичный ключ — бэкенду не нужен, хранится здесь для справки (он для фронтенда).
SUPABASE_ANON_KEY=

# Максимальная длина видео в секундах (3600 = 1 час)
MAX_VIDEO_DURATION_SEC=3600

# Модель Claude для генерации твитов
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---- Необязательные настройки (можно не трогать) ----

# Максимум символов транскрипта, которые отправляем в Claude (экономия денег)
# MAX_TRANSCRIPT_CHARS=60000

# Cookies YouTube (содержимое файла cookies.txt в формате Netscape).
# Нужны ТОЛЬКО если YouTube на сервере отвечает "Sign in to confirm you're not a bot".
# Используйте отдельный, не основной Google-аккаунт!
# YTDLP_COOKIES=
