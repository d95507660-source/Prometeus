# .env.example — скопируй в .env и заполни нужное (файл .env в git не попадает).
# Полная таблица переменных — README.md → «Переменные окружения».

# GCP (если не указано в config.json)
GCP_PROJECT_ID=
GCP_BILLING_ACCOUNT=

# LLM
TOGETHER_API_KEY=
ANTHROPIC_API_KEY=

# Тренды
APIFY_API_TOKEN=
YOUTUBE_API_KEY=

# Проверка аккаунтов (account_health): по одной паре на устройство, ID — верхний регистр, «-» → «_»
# TIKTOK_TOKEN_ARIA_FIGHT=
# INSTAGRAM_TOKEN_ARIA_FIGHT=

# Локальный GPU (gcp.mode=local): одинаковый токен на воркере и на машине с orchestrator
LOCAL_WORKER_TOKEN=

# HTTP-режим model_server
MODEL_SERVER_TOKEN=

# JS: Fanvue / Anlora
FANVUE_TOKEN=
ANLORA_BASE_URL=
ANLORA_API_KEY=

LOG_LEVEL=INFO
